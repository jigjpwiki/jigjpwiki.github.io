{
  "name": "jigwiki-admin",
  "main": "build/worker.mjs",
  "compatibility_date": "2026-06-18",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory":"./public", "binding":"ASSETS", "run_worker_first":["/api/*","/auth/*"]},
  "durable_objects": {"bindings":[{"name":"ADMIN","class_name":"Admin"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["Admin"]}],
  "vars":{"ADMIN_ENABLED":"false","GITHUB_CLIENT_ID":"","ADMIN_USER_IDS":""}
}
