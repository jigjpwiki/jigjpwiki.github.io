{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "talentIds",
          "groupIds",
          "date",
          "recursYearly",
          "countYears",
          "sourceRefs",
          "visibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ann-[0-9]{6}$"
          },
          "type": {
            "enum": [
              "birthday",
              "debut",
              "group",
              "other"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "talentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^tal-[0-9]{6}$"
            },
            "uniqueItems": true
          },
          "groupIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^group-[0-9]{6}$"
            },
            "uniqueItems": true
          },
          "date": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "month",
              "day",
              "year"
            ],
            "properties": {
              "month": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "day": {
                "type": "integer",
                "minimum": 1,
                "maximum": 31
              },
              "year": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1900,
                    "maximum": 2200
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "recursYearly": {
            "type": "boolean"
          },
          "countYears": {
            "type": "boolean"
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^src-[a-z0-9-]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "visibility": {
            "enum": [
              "public",
              "draft"
            ]
          }
        }
      }
    }
  }
}
