{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "groups"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "organizationId",
          "talentIds",
          "membersComplete",
          "visibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^group-[0-9]{6}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "organizationId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^org-[0-9]{6}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "talentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^tal-[0-9]{6}$"
            },
            "uniqueItems": true
          },
          "membersComplete": {
            "type": "boolean"
          },
          "visibility": {
            "enum": [
              "public",
              "draft"
            ]
          },
          "formerTalentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^tal-[0-9]{6}$"
            },
            "uniqueItems": true,
            "description": "過去に在籍した人物。現所属一覧とは分離して履歴を保持。"
          }
        }
      }
    }
  }
}
