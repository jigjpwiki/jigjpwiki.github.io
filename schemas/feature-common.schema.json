{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.jigdule.jp/schemas/feature-common",
  "definitions": {
    "time": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "precision",
            "value"
          ],
          "properties": {
            "precision": {
              "const": "instant"
            },
            "value": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "precision",
            "value"
          ],
          "properties": {
            "precision": {
              "const": "date"
            },
            "value": {
              "type": "string",
              "format": "date"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "precision",
            "value"
          ],
          "properties": {
            "precision": {
              "const": "month"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "precision",
            "value"
          ],
          "properties": {
            "precision": {
              "const": "unknown"
            },
            "value": {
              "type": "null"
            }
          }
        }
      ]
    }
  }
}
