{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "videos"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "youtubeId",
          "channelId",
          "title",
          "publishedAt",
          "startedAt",
          "endedAt",
          "durationSeconds",
          "availability",
          "visibility"
        ],
        "properties": {
          "youtubeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          },
          "channelId": {
            "type": "string",
            "pattern": "^UC[\\w-]{22}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "publishedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "startedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "endedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "durationSeconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "enum": [
              "public",
              "unavailable",
              "unknown"
            ]
          },
          "visibility": {
            "enum": [
              "public",
              "draft"
            ]
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
