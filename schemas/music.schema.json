{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "songs",
    "musicVideos"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "songs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "originalArtists",
          "aliases",
          "readings",
          "identityUrl",
          "artistEvidence",
          "sourceRefs",
          "visibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^song-[0-9]{6}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "originalArtists": {
            "anyOf": [
              {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "minItems": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "readings": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "identityUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "public-url"
              },
              {
                "type": "null"
              }
            ]
          },
          "artistEvidence": {
            "enum": [
              "original_source",
              "performer_description",
              "unknown"
            ]
          },
          "sourceRefs": {
            "$ref": "https://www.jigdule.jp/schemas/feature-common#/definitions/refs"
          },
          "visibility": {
            "enum": [
              "public",
              "draft"
            ]
          },
          "identityStatus": {
            "enum": [
              "verified",
              "unresolved"
            ]
          },
          "identityAliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "public-url"
            }
          },
          "externalIds": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "entityType",
                "id",
                "sourceUrl",
                "status",
                "checkedAt"
              ],
              "properties": {
                "provider": {
                  "const": "musicbrainz"
                },
                "entityType": {
                  "enum": [
                    "work",
                    "recording",
                    "release-group",
                    "artist"
                  ]
                },
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f-]{36}$"
                },
                "sourceUrl": {
                  "type": "string",
                  "format": "public-url"
                },
                "status": {
                  "const": "verified"
                },
                "checkedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "identityUrl": {
                  "type": "null"
                }
              }
            },
            "then": {
              "required": [
                "identityStatus"
              ],
              "properties": {
                "identityStatus": {
                  "const": "unresolved"
                },
                "visibility": {
                  "const": "draft"
                },
                "identityAliases": {
                  "maxItems": 0,
                  "type": "array"
                }
              }
            },
            "else": {
              "properties": {
                "identityStatus": {
                  "const": "verified"
                }
              }
            }
          }
        ]
      }
    },
    "musicVideos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "songId",
          "rawSongTitle",
          "talentIds",
          "youtubeId",
          "registeredAt",
          "sourceRefs",
          "visibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^mv-[0-9]{6}$"
          },
          "type": {
            "enum": [
              "original",
              "cover",
              "other"
            ]
          },
          "songId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^song-[0-9]{6}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rawSongTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "talentIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^tal-[0-9]{6}$"
            },
            "minItems": 1
          },
          "youtubeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time"
          },
          "sourceRefs": {
            "$ref": "https://www.jigdule.jp/schemas/feature-common#/definitions/refs"
          },
          "visibility": {
            "enum": [
              "public",
              "draft"
            ]
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
