{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "baseHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "resultHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "allocated": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(song|mv|karaoke|perf)-[0-9]{6}$"
      }
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "youtubeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          },
          "candidateEvidenceHash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidenceHistory": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "kind": {
            "enum": [
              "karaoke",
              "music-video"
            ]
          },
          "talentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^tal-[0-9]{6}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "media": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channelId",
              "title",
              "publishedAt",
              "startedAt",
              "endedAt",
              "durationSeconds",
              "availability"
            ],
            "properties": {
              "channelId": {
                "type": "string",
                "pattern": "^UC[\\w-]{22}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "publishedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "startedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "endedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "durationSeconds": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "availability": {
                "enum": [
                  "public",
                  "unavailable",
                  "unknown"
                ]
              }
            }
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time"
          },
          "videoType": {
            "enum": [
              "original",
              "cover",
              "collaboration",
              "other",
              null
            ]
          },
          "song": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "existingId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^song-[0-9]{6}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "originalArtists": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "minItems": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "identityUrl": {
                    "type": "string",
                    "format": "public-url"
                  },
                  "externalIds": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "provider",
                        "entityType",
                        "id",
                        "status",
                        "sourceUrl"
                      ],
                      "properties": {
                        "provider": {
                          "const": "musicbrainz"
                        },
                        "entityType": {
                          "enum": [
                            "work",
                            "recording",
                            "release-group",
                            "artist"
                          ]
                        },
                        "id": {
                          "type": "string",
                          "pattern": "^[0-9a-f-]{36}$"
                        },
                        "status": {
                          "const": "verified"
                        },
                        "sourceUrl": {
                          "type": "string",
                          "format": "public-url"
                        }
                      }
                    }
                  }
                },
                "required": [
                  "existingId",
                  "title",
                  "originalArtists",
                  "identityUrl"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "youtubeId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{11}$"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{24}$"
                },
                "evidenceHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "evidenceHistory": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "sourceType": {
                  "enum": [
                    "official_description",
                    "official_chapter",
                    "viewer_comment",
                    "manual_review"
                  ]
                },
                "rawLabel": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "song": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "existingId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^song-[0-9]{6}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "originalArtists": {
                          "anyOf": [
                            {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 200
                              },
                              "minItems": 1
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "identityUrl": {
                          "type": "string",
                          "format": "public-url"
                        },
                        "externalIds": {
                          "type": "array",
                          "maxItems": 20,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "provider",
                              "entityType",
                              "id",
                              "status",
                              "sourceUrl"
                            ],
                            "properties": {
                              "provider": {
                                "const": "musicbrainz"
                              },
                              "entityType": {
                                "enum": [
                                  "work",
                                  "recording",
                                  "release-group",
                                  "artist"
                                ]
                              },
                              "id": {
                                "type": "string",
                                "pattern": "^[0-9a-f-]{36}$"
                              },
                              "status": {
                                "const": "verified"
                              },
                              "sourceUrl": {
                                "type": "string",
                                "format": "public-url"
                              }
                            }
                          }
                        }
                      },
                      "required": [
                        "existingId",
                        "title",
                        "originalArtists",
                        "identityUrl"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "order": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "startsAtSeconds": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "talentIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^tal-[0-9]{6}$"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "approvals": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "kind",
                      "talentIds",
                      "media",
                      "song",
                      "videoType",
                      "completeness",
                      "order",
                      "startsAtSeconds",
                      "value"
                    ]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "status": {
                        "const": "verified"
                      },
                      "valueHash": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "evidenceHash": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "status",
                      "valueHash",
                      "evidenceHash"
                    ]
                  }
                },
                "manualReview": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "const": "verified"
                        },
                        "evidenceHash": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "status",
                        "evidenceHash"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "youtubeId",
                "key",
                "evidenceHash",
                "evidenceHistory",
                "sourceType",
                "rawLabel",
                "song",
                "order",
                "startsAtSeconds",
                "talentIds",
                "approvals",
                "manualReview"
              ]
            },
            "maxItems": 200
          },
          "completeness": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "complete": {
                    "type": "boolean"
                  },
                  "expectedCount": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "complete",
                  "expectedCount"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "approvals": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "kind",
                "talentIds",
                "media",
                "song",
                "videoType",
                "completeness",
                "order",
                "startsAtSeconds",
                "value"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "const": "verified"
                },
                "valueHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "evidenceHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "status",
                "valueHash",
                "evidenceHash"
              ]
            }
          }
        },
        "required": [
          "youtubeId",
          "candidateEvidenceHash",
          "evidenceHash",
          "evidenceHistory",
          "kind",
          "talentIds",
          "media",
          "registeredAt",
          "videoType",
          "song",
          "entries",
          "completeness",
          "approvals"
        ]
      },
      "maxItems": 100
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "master": {
            "enum": [
              "music",
              "karaoke"
            ]
          },
          "collection": {
            "enum": [
              "songs",
              "musicVideos",
              "karaokes",
              "performances"
            ]
          },
          "id": {
            "type": "string"
          },
          "expectedHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidenceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidenceHistory": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "value": {
            "type": "object"
          },
          "approvals": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "kind",
                "talentIds",
                "media",
                "song",
                "videoType",
                "completeness",
                "order",
                "startsAtSeconds",
                "value"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "const": "verified"
                },
                "valueHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "evidenceHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "status",
                "valueHash",
                "evidenceHash"
              ]
            }
          }
        },
        "required": [
          "master",
          "collection",
          "id",
          "expectedHash",
          "evidenceHash",
          "evidenceHistory",
          "value",
          "approvals"
        ]
      },
      "maxItems": 200
    }
  },
  "required": [
    "schemaVersion",
    "baseHash",
    "resultHash",
    "allocated",
    "videos",
    "patches"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
